# Postgres
DB_PASSWORD=change-me

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# EventHub backend
# spring.security.user.password — Spring'in dahili in-memory kullanıcısı için (uygulamanın
# kendi JWT/DB tabanlı auth'undan bağımsız, Spring Boot varsayılan güvenlik kullanıcısı).
USER_PASSWORD=change-me
# JWT imzalama anahtarı — Base64, HS256 için en az 32 byte çözülmeli. Kendi ortamın için
# yeni bir anahtar üret (ör. `openssl rand -base64 48`) ve gizli tut.
JWT_SECRET_KEY=change-me
